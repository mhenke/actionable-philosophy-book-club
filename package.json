{
  "name": "actionable-philosophy-book-club",
  "version": "1.0.0",
  "description": "Static SPA for philosophy book club meetings",
  "type": "module",
  "scripts": {
    "build:vendor": "cp node_modules/marked/marked.min.js node_modules/dompurify/dist/purify.min.js dist/vendor/",
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i src/input.css -o dist/tailwind.css --minify",
    "test": "playwright test",
    "test:links": "bash tests/check-links.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "autoprefixer": "^10.5.0",
    "dompurify": "^3.2.4",
    "marked": "^15.0.12",
    "tailwindcss": "3.4.17"
  }
}
